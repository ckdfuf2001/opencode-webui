{
  "name": "opencode-webui",
  "version": "0.12.72",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "predev": "node scripts/predev.js",
    "postinstall": "node scripts/install-tesseract.js || echo tesseract skipped",
    "opencode:install": "node scripts/install-opencode.js",
    "tesseract:install": "node scripts/install-tesseract.js",
    "dev": "concurrently --kill-others-on-fail \"pnpm:dev:backend\" \"node scripts/wait-backend.js && pnpm run dev:frontend\"",
    "dev:backend": "node --watch --disable-warning=ExperimentalWarning --experimental-transform-types --import ./scripts/node-compat/register.mjs backend/src/index.ts",
    "dev:backend:bun": "bun --watch backend/src/index.ts",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm run build:backend && pnpm run build:frontend",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "check:memory": "node scripts/check-memory-rules.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "test": "pnpm run check:encoding && pnpm run check:memory && pnpm run test:backend",
    "test:backend": "pnpm --filter backend test",
    "test:e2e:collab": "playwright test -c e2e/collab/playwright.config.ts",
    "generate:openapi": "bun scripts/generate-openapi.ts",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down -v",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "concurrently": "^9.1.0",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.1"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "dotenv": "^17.2.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "ooxml-ui@1.8.0": "patches/ooxml-ui@1.8.0.patch",
      "pptx-react-viewer@4.33.0": "patches/pptx-react-viewer@4.33.0.patch",
      "ooxml-core@1.8.0": "patches/ooxml-core@1.8.0.patch"
    }
  }
}
