# OpenCode WebUI Configuration
# Copy this file to .env and customize as needed
# Default values are defined in: shared/src/config/defaults.ts

# ============================================
# Backend Server Configuration
# ============================================
PORT=5001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# ============================================
# OpenCode Server
# ============================================
OPENCODE_SERVER_PORT=5552
OPENCODE_HOST=127.0.0.1
# Optional: point to a pre-downloaded opencode executable so no internet is needed at runtime.
# The backend also auto-detects: ./bin/opencode.exe, <workspace>/bin/opencode.exe,
# the npm-global copy (%APPDATA%\npm\node_modules\opencode-ai\bin\opencode.exe),
# ~/.bun/bin, ~/.opencode/bin, and the PATH.
# OPENCODE_BIN=C:\path\to\opencode.exe

# ============================================
# OpenCode Memory (Go runtime)
# opencode serve는 Go 바이너리라 GOMEMLIMIT/GOGC로 메모리 제한. 백엔드 재시작 필요.
# 예: 2GiB 소프트 리밋, 넘으면 GC가 공격적으로 동작해 OOM 방지
# ============================================
GOMEMLIMIT=2GiB
# GOGC=80
# GOMAXPROCS=4

# ============================================
# Database
# ============================================
DATABASE_PATH=./data/opencode.db

# ============================================
# Workspace Configuration
# ============================================
WORKSPACE_PATH=./workspace

# ============================================
# Timeouts (milliseconds)
# ============================================
PROCESS_START_WAIT_MS=2000
PROCESS_VERIFY_WAIT_MS=1000
HEALTH_CHECK_INTERVAL_MS=5000
HEALTH_CHECK_TIMEOUT_MS=30000

# ============================================
# File Limits (MB)
# ============================================
MAX_FILE_SIZE_MB=50
MAX_UPLOAD_SIZE_MB=50

# ============================================
# Logging
# ============================================
DEBUG=false

# ============================================
# Frontend Configuration (Vite)
# These are optional - frontend uses defaults if not set
# ============================================
# IMPORTANT: leave VITE_API_URL UNSET so the frontend uses same-origin (/api)
# paths. Setting an absolute URL like http://localhost:5002 breaks access from
# other machines/browsers, because it resolves to the CLIENT's own localhost,
# not this server. The vite dev server proxies /api to the backend already.
# VITE_API_URL=
# VITE_SERVER_PORT=5002
# VITE_OPENCODE_PORT=5552
# VITE_MAX_FILE_SIZE_MB=50
# VITE_MAX_UPLOAD_SIZE_MB=50

# ============================================
# Browser Automation (Playwright MCP via npx, no env needed)
# ============================================
# Playwright MCP is used via npx --yes @playwright/mcp --headless --isolated
# No environment variable required. First use auto-installs.
